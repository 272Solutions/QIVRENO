{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qivreno",
  "version": "1.5.0",
  "identifier": "com.272solutions.qivreno",
  "mainBinaryName": "Qivreno",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qivreno",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "272 Solutions LLC",
    "copyright": "\u00a9 2026 272 Solutions LLC"
  }
}